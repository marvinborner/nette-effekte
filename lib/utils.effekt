// to be potentially added to Effekt's standard library

import test

type Either[A, B] { Left(a: A); Right(b: B); }

def collapse[A, B, R](port: Either[A, B]) { left: A => R } { right: B => R }: R = port match {
  case Left(a)  => left(a)
  case Right(b) => right(b)
}

def size[A] { s: => Unit / emit[A] }: Int = {
  var size = 0
  try s()
  with emit[A] { _ => size = size + 1}
  size
}

def pop[A] { stream: => Unit / emit[A] }: A / { fail, emit[A] } =
  try {
    def body(): Option[A] = { stream(); None() }
    body()
  } with emit[A] { a =>
    val next = resume(())
    if (next is Some(a)) do emit(a)
    Some(a)
  }.getOrFail

def popRandom[A] { stream: => Unit / emit[A] }: A / { fail, emit[A] } =
  try {
    def body(): Option[A] = { stream(); None() }
    body()
  } with emit[A] { a =>
    val next = resume(())
    next match {
      case None() => Some(a)
      case Some(b) =>
        if (random() > 0.5) {
          do emit(b)
          Some(a)
        } else {
          do emit(a)
          Some(b)
        }
    }
  }.getOrFail

def exhaustively[R](init: R) { program: () => R / fail }: R =
  var res: R = init
  try {
    def go(): R = {
      res = program()
      go()
    }
    go()
  } with fail {
    res
  }
