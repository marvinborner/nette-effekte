import test

import test/ic
import test/lc
import test/net
import test/layout
import test/ruler

def main() = mainSuite("nette-tests") {
  test("run suites") {
    assertTrue(true)
    assertFalse(false)

    val suites = [ic::tests(), lc::tests(), net::tests(), layout::tests(), ruler::tests()]
    assertTrue(suites.all { passed => passed })
  }
}
